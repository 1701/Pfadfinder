// Cloudflare Workers with Static Assets (docs/DEPLOY.md). No Worker script: Cloudflare serves
// dist/ directly. Unknown paths get index.html, so React Router routes like /ueben/… work when
// opened directly or reloaded.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pfadfinder",
  // The newest date the installed workerd supports (wrangler 4.142.0 → workerd 1.20260926).
  "compatibility_date": "2026-09-26",
  // pfadfinder.<subdomain>.workers.dev, plus a preview URL for every uploaded version.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
